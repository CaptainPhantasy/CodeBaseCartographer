# ============================================================================
# Codebase Cartographer - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in values as needed.
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Provider API Keys (server-side only — never shipped to the browser)
# The backend /api/llm/* proxy reads these; keys never reach the client.
# Set only the keys for providers you intend to use.
# ----------------------------------------------------------------------------

# Google AI (Gemini)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter (multi-provider proxy)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ElevenLabs (text-to-speech)
# Get your key at: https://elevenlabs.io/api
ELEVENLABS_API_KEY=

# Local / self-hosted LLM endpoint (e.g. Ollama, LM Studio)
# Set to the base URL, e.g. http://localhost:11434
LOCAL_LLM_ENDPOINT=

# ----------------------------------------------------------------------------
# Backend server — security configuration
# ----------------------------------------------------------------------------
# The Express server enforces JWT auth, CORS, security headers, and rate
# limiting. See server/src/middleware/.

# Secret used to sign JWT access/refresh tokens.
# If unset, an ephemeral random secret is generated at boot (tokens are
# invalidated on every server restart).
JWT_SECRET=

# Password for POST /api/auth/login.
# If unset, a random one-time password is generated and printed to the
# server console at startup (the server is never fail-open).
AUTH_PASSWORD=

# Explicitly disable API authentication (local development only).
# AUTH_DISABLED=true

# Comma-separated list of allowed CORS origins.
# Default: http://localhost:7443,http://127.0.0.1:7443 (the Vite dev server)
ALLOWED_ORIGINS=

# Rate limiting overrides (defaults: 100 req/15min general, 10 req/min proxy)
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_GENERAL_MAX=100
# RATE_LIMIT_STRICT_WINDOW_MS=60000
# RATE_LIMIT_STRICT_MAX=10
