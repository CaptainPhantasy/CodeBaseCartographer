# ============================================================================
# Codebase Cartographer - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your API keys
# ============================================================================

# ----------------------------------------------------------------------------
# IMPORTANT: API keys are now managed through the in-app Settings UI
# These environment variables are optional and serve as fallbacks
# ----------------------------------------------------------------------------

# Google AI (Gemini) - Required for full functionality
# Get your key at: https://aistudio.google.com/app/apikey
# Capabilities: Text, Code, Vision, TTS, Video (Veo), Real-time Voice
VITE_GOOGLE_API_KEY=

# OpenAI - Alternative provider
# Get your key at: https://platform.openai.com/api-keys
# Capabilities: Text, Code, Vision, TTS, Real-time Voice (gpt-4o-realtime)
VITE_OPENAI_API_KEY=

# Anthropic (Claude) - Alternative provider
# Get your key at: https://console.anthropic.com/
# Capabilities: Text, Code, Vision, Extended Thinking
VITE_ANTHROPIC_API_KEY=

# OpenRouter - Multi-provider proxy
# Get your key at: https://openrouter.ai/keys
# Capabilities: Access to 200+ models from various providers
VITE_OPENROUTER_API_KEY=

# ElevenLabs - Premium TTS
# Get your key at: https://elevenlabs.io/api
# Capabilities: High-quality text-to-speech with many voice options
VITE_ELEVENLABS_API_KEY=

# ----------------------------------------------------------------------------
# Legacy API_KEY variable (for backwards compatibility)
# If set, will be used as Google API key fallback
# ----------------------------------------------------------------------------
API_KEY=

# ============================================================================
# Backend server (server/) — security configuration
# ============================================================================
# The Express server enforces JWT auth, an explicit CORS whitelist, security
# headers (helmet), and rate limiting. See server/src/middleware/.

# Secret used to sign JWT access/refresh tokens.
# If unset, an ephemeral random secret is generated at boot (tokens are
# invalidated on every server restart).
JWT_SECRET=

# Password for POST /api/auth/login.
# If unset, a random one-time password is generated and printed to the
# server console at startup (the server is never fail-open).
AUTH_PASSWORD=

# Explicitly disable API authentication (local development only).
# AUTH_DISABLED=true

# Comma-separated list of allowed CORS origins.
# Default: http://localhost:7443,http://127.0.0.1:7443 (the Vite dev server)
ALLOWED_ORIGINS=

# Rate limiting overrides (defaults: 100 req/15min general, 10 req/min proxy)
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_GENERAL_MAX=100
# RATE_LIMIT_STRICT_WINDOW_MS=60000
# RATE_LIMIT_STRICT_MAX=10

# ElevenLabs key used by the server-side preview proxy (server-side only,
# never shipped to the browser)
ELEVENLABS_API_KEY=
