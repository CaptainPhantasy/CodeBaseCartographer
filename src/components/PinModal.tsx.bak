/**
 * PIN Modal Component
 * Provides UI for setting up and entering a PIN for API key encryption
 */

import React, { useState, useEffect, useCallback, useRef } from 'react';
import {
  isPinSetUp,
  validatePin,
  setupPin,
  storePinInSession,
  getPinFromSession,
  isValidPin,
  clearPinSetup
} from '../utils/cryptoUtils';

// ============================================================================
// TYPES
// ============================================================================

type PinMode = 'setup' | 'enter' | 'confirm';

interface PinModalProps {
  /** Called when PIN is successfully entered or setup */
  onUnlock: () => void;
  /** Optional error message to display */
  error?: string;
  /** Allow PIN reset */
  allowReset?: boolean;
}

// ============================================================================
// COMPONENT
// ============================================================================

export const PinModal: React.FC<PinModalProps> = ({ onUnlock, error: externalError, allowReset = true }) => {
  const [mode, setMode] = useState<PinMode>('enter');
  const [pin, setPin] = useState('');
  const [confirmPin, setConfirmPin] = useState('');
  const [isVerifying, setIsVerifying] = useState(false);
  const [error, setError] = useState<string | undefined>(externalError);
  const [showReset, setShowReset] = useState(false);
  const inputRefs = useRef<(HTMLInputElement | null)[]>([]);
  const activePinIndex = mode === 'confirm' ? confirmPin.length : pin.length;

  // Check if PIN is set up on mount
  useEffect(() => {
    const pinSetUp = isPinSetUp();
    if (!pinSetUp) {
      setMode('setup');
    } else {
      // Check if PIN is already in session
      const sessionPin = getPinFromSession();
      if (sessionPin) {
        // Auto-unlock if PIN is in session
        onUnlock();
      } else {
        setMode('enter');
      }
    }
  }, [onUnlock]);

  // Update error from props
  useEffect(() => {
    setError(externalError);
  }, [externalError]);

  // Focus next input or handle submission
  useEffect(() => {
    if (mode === 'setup' || mode === 'enter') {
      if (pin.length === 6) {
        handleSubmit();
      } else {
        inputRefs.current[pin.length]?.focus();
      }
    } else if (mode === 'confirm') {
      if (confirmPin.length === 6) {
        handleSubmit();
      } else {
        inputRefs.current[confirmPin.length]?.focus();
      }
    }
  }, [pin, confirmPin, mode]);

  const handleDigitClick = (digit: string) => {
    if (mode === 'confirm') {
      if (confirmPin.length < 6) {
        setConfirmPin(prev => prev + digit);
      }
    } else {
      if (pin.length < 6) {
        setPin(prev => prev + digit);
      }
    }
  };

  const handleBackspace = () => {
    if (mode === 'confirm') {
      setConfirmPin(prev => prev.slice(0, -1));
    } else {
      setPin(prev => prev.slice(0, -1));
    }
  };

  const handleClear = () => {
    setPin('');
    setConfirmPin('');
    setError(undefined);
  };

  const handleSubmit = async () => {
    const currentPin = mode === 'confirm' ? confirmPin : pin;

    // Validate PIN format
    if (!isValidPin(currentPin)) {
      setError('PIN must be at least 4 digits');
      return;
    }

    setIsVerifying(true);
    setError(undefined);

    try {
      if (mode === 'setup') {
        // First time setup - go to confirmation
        if (confirmPin === '') {
          setMode('confirm');
          setIsVerifying(false);
        } else {
          // Confirm PINs match
          if (pin !== confirmPin) {
            setError('PINs do not match');
            setConfirmPin('');
            setMode('setup');
            setIsVerifying(false);
            return;
          }

          // Setup PIN
          await setupPin(pin);
          storePinInSession(pin);
          onUnlock();
        }
      } else if (mode === 'enter') {
        // Verify PIN
        const isValid = await validatePin(pin);
        if (isValid) {
          storePinInSession(pin);
          onUnlock();
        } else {
          setError('Incorrect PIN');
          setPin('');
        }
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : 'An error occurred');
    } finally {
      setIsVerifying(false);
    }
  };

  const handleReset = async () => {
    if (showReset) {
      clearPinSetup();
      setMode('setup');
      setShowReset(false);
      setPin('');
      setConfirmPin('');
      setError(undefined);
    } else {
      setShowReset(true);
    }
  };

  // Get current PIN display value
  const currentPin = mode === 'confirm' ? confirmPin : pin;

  return (
    <div className="fixed inset-0 bg-slate-950/95 z-50 flex items-center justify-center p-4">
      <div className="w-full max-w-md">
        {/* Main Card */}
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl">
          {/* Icon */}
          <div className="flex justify-center mb-6">
            <div className="w-20 h-20 bg-gradient-to-br from-cyan-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-cyan-500/20">
              <svg className="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
          </div>

          {/* Title and Description */}
          <div className="text-center mb-8">
            <h2 className="text-2xl font-bold text-white mb-2">
              {mode === 'setup' && 'Create a PIN'}
              {mode === 'confirm' && 'Confirm Your PIN'}
              {mode === 'enter' && 'Enter Your PIN'}
            </h2>
            <p className="text-slate-400 text-sm">
              {mode === 'setup' && 'Choose a 4-6 digit PIN to secure your API keys. You\'ll enter this once per browser session.'}
              {mode === 'confirm' && 'Enter your PIN again to confirm.'}
              {mode === 'enter' && 'Enter your PIN to unlock your API keys for this session.'}
            </p>
          </div>

          {/* PIN Display */}
          <div className="flex justify-center gap-3 mb-8">
            {[0, 1, 2, 3, 4, 5].map((index) => (
              <div
                key={index}
                className={`w-12 h-14 rounded-lg border-2 flex items-center justify-center transition-all ${
                  index === activePinIndex
                    ? 'border-cyan-500 bg-cyan-500/10'
                    : 'border-slate-700 bg-slate-800'
                }`}
              >
                {index < currentPin.length && (
                  <div className="w-3 h-3 rounded-full bg-cyan-500" />
                )}
              </div>
            ))}
          </div>

          {/* Error Message */}
          {error && (
            <div className="mb-6 bg-red-500/10 border border-red-500/20 rounded-lg p-3">
              <p className="text-red-400 text-sm text-center">{error}</p>
            </div>
          )}

          {/* Number Pad */}
          <div className="grid grid-cols-3 gap-3 mb-6">
            {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((num) => (
              <button
                key={num}
                onClick={() => handleDigitClick(num.toString())}
                disabled={isVerifying}
                className="h-14 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 disabled:hover:bg-slate-800 border border-slate-700 rounded-lg text-white text-xl font-medium transition-colors"
              >
                {num}
              </button>
            ))}
            <button
              onClick={handleBackspace}
              disabled={isVerifying || currentPin.length === 0}
              className="h-14 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 disabled:hover:bg-slate-800 border border-slate-700 rounded-lg text-white transition-colors flex items-center justify-center"
            >
              <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 001.414.586H19a2 2 0 002-2V7a2 2 0 00-2-2h-8.172a2 2 0 00-1.414.586L3 12z' />
              </svg>
            </button>
            <button
              onClick={() => handleDigitClick('0')}
              disabled={isVerifying}
              className="h-14 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 disabled:hover:bg-slate-800 border border-slate-700 rounded-lg text-white text-xl font-medium transition-colors"
            >
              0
            </button>
            <button
              onClick={handleClear}
              disabled={isVerifying || currentPin.length === 0}
              className="h-14 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 disabled:hover:bg-slate-800 border border-slate-700 rounded-lg text-white text-sm transition-colors"
            >
              Clear
            </button>
          </div>

          {/* Reset PIN (only in enter mode) */}
          {allowReset && mode === 'enter' && (
            <div className="text-center">
              {showReset ? (
                <div className="space-y-3">
                  <p className="text-amber-400 text-sm">
                    Warning: This will clear all encrypted API keys. Are you sure?
                  </p>
                  <div className="flex gap-3 justify-center">
                    <button
                      onClick={() => setShowReset(false)}
                      className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm transition-colors"
                    >
                      Cancel
                    </button>
                    <button
                      onClick={handleReset}
                      className="px-4 py-2 bg-red-600 hover:bg-red-500 text-white rounded-lg text-sm transition-colors"
                    >
                      Reset PIN
                    </button>
                  </div>
                </div>
              ) : (
                <button
                  onClick={() => setShowReset(true)}
                  className="text-slate-500 hover:text-slate-400 text-sm transition-colors"
                >
                  Forgot PIN? Reset
                </button>
              )}
            </div>
          )}

          {/* Setup Mode Info */}
          {mode === 'setup' && (
            <div className="mt-6 bg-cyan-500/10 border border-cyan-500/20 rounded-lg p-3">
              <p className="text-cyan-400 text-xs text-center">
                <strong>Security Note:</strong> Your PIN encrypts API keys locally. Keys are never sent to any server.
              </p>
            </div>
          )}
        </div>

        {/* Footer Info */}
        <div className="mt-4 text-center">
          <p className="text-slate-600 text-xs">
            PIN is stored in your browser only and cleared when you close it.
          </p>
        </div>
      </div>
    </div>
  );
};

export default PinModal;
