{
  "name": "codebase-cartographer-server",
  "version": "1.0.0",
  "description": "Backend service for CodeBaseCartographer - file operations, watching, and task persistence",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "codebase-cartographer": "./dist/cli.js"
  },
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:server": "tsx src/testServer.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.10.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.0.2",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
